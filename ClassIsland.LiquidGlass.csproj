<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CreateCipx>true</CreateCipx>
    <GenerateHashSummary>false</GenerateHashSummary>
    <RootNamespace>ClassIsland.LiquidGlass</RootNamespace>
    <AssemblyName>ClassIsland.LiquidGlass</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <ClassIslandPluginSdkVersion>2.0.0.*</ClassIslandPluginSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <!-- 应用自带 Avalonia.Markup.Xaml.Loader（版本可能与应用不同，如 11.0/11.2）。
         插件通过反射调用应用已加载的副本；本引用仅用于获取随插件携带的回退副本
         （应用完全没有该程序集时使用），版本与 SDK 所依赖的 Avalonia 11.3.6 对齐，
         且不得打进默认上下文（同简单名程序集会触发 FileLoadException）。 -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.6"
                      ExcludeAssets="runtime; native"
                      GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgAvalonia_Markup_Xaml_Loader)/lib/net8.0/Avalonia.Markup.Xaml.Loader.dll"
          Link="Avalonia.Markup.Xaml.Loader.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="XamlThemes\LiquidGlass\Styles.axaml" />
    <AvaloniaResource Include="XamlThemes\LiquidGlass\Styles.axaml"
                      Link="XamlThemes\LiquidGlass\Styles.axamlx" />
    <AvaloniaResource Include="icon.png" />
    <AvaloniaResource Include="Assets\noise.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DisableCipxHashSummary" BeforeTargets="CreateCipx">
    <PropertyGroup>
      <GenerateHashSummary>false</GenerateHashSummary>
    </PropertyGroup>
  </Target>

</Project>