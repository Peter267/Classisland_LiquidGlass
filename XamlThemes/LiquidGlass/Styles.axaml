<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClassIsland.Controls;assembly=ClassIsland"
        xmlns:classIsland="clr-namespace:ClassIsland;assembly=ClassIsland"
        xmlns:ci="http://classisland.tech/schemas/xaml/core"
        xmlns:lq="clr-namespace:ClassIsland.LiquidGlass.Controls;assembly=ClassIsland.LiquidGlass"
        xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Styles.Resources>
        <ci:WidthDoubleToRectConverter x:Key="WidthDoubleToRectConverter" />
        <ci:ColorToColorPickerBrushConverter x:Key="ColorToColorPickerBrushConverter" />
        <ci:SizeDoubleToCornerRadiusConverter x:Key="SizeDoubleToCornerRadiusConverter" />
        <ci:BooleanToBooleanReConverter x:Key="InvertBooleanConverter" />
<ci:DoubleToThicknessMultiConverter x:Key="DoubleToThicknessMultiConverter" />
        <ci:BooleanOrExpressionMultiConverter x:Key="BooleanOrExpressionMultiConverter" />
        <system:Double x:Key="IslandContainerHeight">40</system:Double>
        <system:Boolean x:Key="LG.ShineEnabled">True</system:Boolean>
        <system:Boolean x:Key="LG.NoiseEnabled">True</system:Boolean>

        <LinearGradientBrush x:Key="LG.BackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#55272B3F" Offset="0"/>
                <GradientStop Color="#2B151826" Offset="0.45"/>
                <GradientStop Color="#40181828" Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LG.HighlightBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#48FFFFFF" Offset="0"/>
                <GradientStop Color="#20FFFFFF" Offset="0.28"/>
                <GradientStop Color="#00FFFFFF" Offset="0.55"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LG.BorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#99FFFFFF" Offset="0"/>
                <GradientStop Color="#19FFFFFF" Offset="0.5"/>
                <GradientStop Color="#4DFFFFFF" Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LG.ShineBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#00FFFFFF" Offset="0"/>
                <GradientStop Color="#1AFFFFFF" Offset="0.42"/>
                <GradientStop Color="#00FFFFFF" Offset="0.85"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="LG.TextBrush" Color="#F4F6FA"/>
    </Styles.Resources>

    <Style Selector="ItemsControl#RootMainWindowLinesItemsControl">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>

    <Style Selector=":is(Control).clip-host[(ci|MainWindowStylesAssist.IsIslandSeperated)=False], :is(Control).clip-host.clip-enforcing">
        <Setter Property="Clip">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource WidthDoubleToRectConverter}">
                    <Binding Path="BackgroundWidth" Mode="OneWay"
                             RelativeSource="{RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}" />
                    <Binding Path="Bounds.Width" Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Bounds.Height" Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="ViewModel.Settings.WindowDockingLocation" Mode="OneWay"
                             RelativeSource="{RelativeSource FindAncestor, AncestorType=classIsland:MainWindow}" />
                    <Binding Path="ViewModel.Settings.RadiusX" Mode="OneWay"
                             RelativeSource="{RelativeSource FindAncestor, AncestorType=classIsland:MainWindow}" />
                    <Binding Path="ViewModel.Settings.RadiusX" Mode="OneWay"
                             RelativeSource="{RelativeSource FindAncestor, AncestorType=classIsland:MainWindow}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.line-background">
        <Setter Property="Background" Value="{DynamicResource LG.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LG.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"/>
        <Setter Property="Opacity" Value="{Binding $self.(ci:MainWindowStylesAssist.BackgroundOpacity), Mode=OneWay}"/>
        <Setter Property="BoxShadow" Value="0 2 16 0 #30000000, 0 0 1 0 #14FFFFFF inset"/>
    </Style>
    <Style Selector="controls|MainWindowLine Border[(ci|MainWindowStylesAssist.IsCustomBackgroundColorEnabled)=True].line-background">
        <Setter Property="Background" Value="{Binding $self.(ci:MainWindowStylesAssist.BackgroundColor), Converter={StaticResource ColorToColorPickerBrushConverter}}"/>
    </Style>

    <Style Selector="controls|MainWindowLine">
        <Setter Property="IsVisible">
            <Setter.Value>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <MultiBinding Converter="{StaticResource BooleanOrExpressionMultiConverter}">
                            <Binding Path="!IsAllComponentsHid" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="IsOverlayOpen" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Settings.HideOnRule" RelativeSource="{RelativeSource Self}"/>
                                <Binding Path="Settings.IsVisible" RelativeSource="{RelativeSource Self}"/>
                            </MultiBinding>
                            <Binding Path="!Settings.HideOnRule" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </MultiBinding>
                    <Binding Path="(ci:MainWindowStylesAssist.MainWindowInEditMode)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Opacity" Value="{Binding $self.Settings.Opacity}"/>

        <Style Selector="^:dock-left /template/:is(Control).docking">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^:dock-center /template/ :is(Control).docking">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:dock-right /template/ :is(Control).docking">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="PointerOver" Value="True"/>
        </Style>
        <Style Selector="^[IsLineFaded=True][(ci|MainWindowStylesAssist.MainWindowInEditMode)=False]">
            <Setter Property="Opacity" Value="0.05"/>
        </Style>

        <Setter Property="CountdownProgressValue" Value="{Binding $self.CurrentNotificationRequest.LeftProgress}"/>
    </Style>

    <Style Selector="controls|MainWindowLine">
        <Style.Resources>
            <ci:WidthDoubleToRectConverter x:Key="WidthDoubleToRectConverter" />
            <ci:ColorToColorPickerBrushConverter x:Key="ColorToColorPickerBrushConverter" />
            <ci:SizeDoubleToCornerRadiusConverter x:Key="SizeDoubleToCornerRadiusConverter" />
<ci:DoubleToThicknessMultiConverter x:Key="DoubleToThicknessMultiConverter" />
            <system:Double x:Key="IslandContainerHeight">40</system:Double>

            <ControlTemplate x:Key="MainWindowLineFullControlTemplate" TargetType="controls:MainWindowLine">
                <Grid ClipToBounds="False"
                      x:Name="GridRoot"
                      HorizontalAlignment="Stretch">

                    <Border x:Name="BackgroundBorderWrapper"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}">
                        <Border x:Name="BackgroundBorder"
                                Classes="docking line-background"
                                Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}"
                                Height="{DynamicResource IslandContainerHeight}"/>
                    </Border>
                    <Border x:Name="BackgroundBorderOverlayMask"
                            Classes="docking primaryColorZone"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                            Opacity="0"
                            VerticalAlignment="Stretch"
                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"
                            ClipToBounds="True"
                            Height="{DynamicResource IslandContainerHeight}"
                            Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}">
                        <Border.Transitions>
                            <Transitions>
                                <BoxShadowsTransition Duration="0:0:0.15" Property="BoxShadow"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border x:Name="GlassHighlightOverlay"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                            IsHitTestVisible="False"
                            Background="{DynamicResource LG.HighlightBrush}"
                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"
                            Height="{DynamicResource IslandContainerHeight}"
                            Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}"
                            ClipToBounds="True"
                            Opacity="1"/>

                    <Border x:Name="GlassShineSweepHost"
                            Classes="docking"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                            IsHitTestVisible="False"
                            ClipToBounds="True"
                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"
                            Height="{DynamicResource IslandContainerHeight}"
                            Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}">
                        <lq:GlassShineSweep IsVisible="{DynamicResource LG.ShineEnabled}"/>
                    </Border>

                    <Border x:Name="GlassNoiseOverlay"
                            Classes="docking"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                            IsHitTestVisible="False"
                            ClipToBounds="True"
                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"
                            Height="{DynamicResource IslandContainerHeight}"
                            Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}">
                        <Border IsVisible="{DynamicResource LG.NoiseEnabled}"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush Source="avares://ClassIsland.LiquidGlass/Assets/noise.png"
                                            TileMode="Tile"
                                            Stretch="None"
                                            Opacity="0.10"/>
                            </Border.Background>
                        </Border>
                    </Border>

                    <Grid x:Name="ContentClipBorder" Classes="clip-host">
                        <Panel Classes="animated-resize" ClipToBounds="False">
                            <Grid x:Name="PART_GridWrapper" ClipToBounds="False"
                                  Height="{DynamicResource IslandContainerHeight}"
                                  Classes="docking">
                                <Grid Height="{DynamicResource IslandContainerHeight}"
                                      x:Name="GridContentRoot"
                                      MinWidth="20"
                                      Margin="12 0">
                                    <ContentPresenter
                                        Content="{Binding Content, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}" />
                                </Grid>

                                <Grid x:Name="GridOverlay"
                                      ClipToBounds="False"
                                      Opacity="0">
                                    <Border
                                        Classes.line-background="{Binding $self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding $self.(ci:MainWindowStylesAssist.IsIslandSeperated)}" />
                                    <Border ClipToBounds="True"
                                            IsHitTestVisible="False"
                                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}">
                                        <Panel>
                                            <Canvas VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Stretch"
                                                    x:Name="ProgressContainer"
                                                    Height="{Binding #OverlayTimeProgressBar.Bounds.Height}">
                                                <ProgressBar VerticalAlignment="Bottom"
                                                             Maximum="1"
                                                             Value="{Binding CountdownProgressValue, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}"
                                                             x:Name="OverlayTimeProgressBar"
                                                             Width="{Binding #ProgressContainer.Bounds.Width, Mode=OneWay}"
                                                             MinWidth="0">
                                                    <ProgressBar.Transitions>
                                                        <Transitions>
                                                            <DoubleTransition Property="Value" Duration="0:0:0.05">
                                                                <DoubleTransition.Easing>
                                                                    <LinearEasing/>
                                                                </DoubleTransition.Easing>
                                                            </DoubleTransition>
                                                        </Transitions>
                                                    </ProgressBar.Transitions>
                                                </ProgressBar>
                                            </Canvas>
                                            <ContentPresenter
                                                MaxHeight="{DynamicResource IslandContainerHeight}"
                                                Content="{Binding OverlayContent.Content, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}"
                                                ContentTemplate="{Binding OverlayContent.ContentTemplate, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}" />
                                        </Panel>
                                    </Border>
                                </Grid>

                                <Border x:Name="OverlayMaskShadowRoot"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.MainWindowInEditMode)}"
                                        CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}">
                                    <Border x:Name="OverlayMask"
                                            TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Height="{DynamicResource IslandContainerHeight}"
                                            RenderTransformOrigin="{x:Static RelativePoint.Center}">
                                        <Border.Transitions>
                                            <Transitions>
                                                <BoxShadowsTransition Duration="0:0:0.15" Property="BoxShadow" />
                                            </Transitions>
                                        </Border.Transitions>
                                        <Panel>
                                            <controls:SlantedMaskControl x:Name="SlantedMaskControlSeperated"
                                                                         Classes="mask-bg"
                                                                         ClipToBounds="True"
                                                                         RegionDurationMs="400"
                                                                         StageStaggerMs="140"
                                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Border
                                                TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                Padding="12 0">
                                                <ContentPresenter x:Name="OverlayMaskContent"
                                                                  Opacity="0"
                                                                  Content="{Binding MaskContent.Content, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}"
                                                                  ContentTemplate="{Binding MaskContent.ContentTemplate, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}">
                                                    <ContentPresenter.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform />
                                                        </TransformGroup>
                                                    </ContentPresenter.RenderTransform>
                                                </ContentPresenter>
                                            </Border>
                                        </Panel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Panel>
                    </Grid>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="MainWindowLineMinControlTemplate" TargetType="controls:MainWindowLine">
                <Grid ClipToBounds="False"
                      x:Name="GridRoot"
                      HorizontalAlignment="Stretch">
                    <Border x:Name="BackgroundBorder"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                            Classes="docking line-background"
                            Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}"
                            Height="{DynamicResource IslandContainerHeight}" />
                    <Grid x:Name="ContentClipBorder" Classes="clip-host">
                        <Panel Classes="animated-resize" ClipToBounds="False">
                            <Grid x:Name="PART_GridWrapper" ClipToBounds="False"
                                  Height="{DynamicResource IslandContainerHeight}"
                                  Classes="docking">
                                <Grid Height="{DynamicResource IslandContainerHeight}"
                                      x:Name="GridContentRoot"
                                      MinWidth="20"
                                      Margin="12 0">
                                    <ContentPresenter
                                        Content="{Binding Content, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}" />
                                </Grid>
                            </Grid>
                        </Panel>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Style.Resources>

        <Style Selector="^ ci|ComponentPresenter[IsRootComponent=True]">
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <Panel>
                        <ContentPresenter Content="{Binding}"/>
                    </Panel>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="^ ci|ComponentPresenter[IsRootComponent=True][(ci|MainWindowStylesAssist.IsIslandSeperated)=True]">
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <Grid>
                        <Border Classes="line-background"/>
                        <Border IsHitTestVisible="False"
                                ClipToBounds="True"
                                Background="{DynamicResource LG.HighlightBrush}"
                                CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"/>
                        <Border IsHitTestVisible="False"
                                ClipToBounds="True"
                                IsVisible="{DynamicResource LG.ShineEnabled}"
                                CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}">
                            <lq:GlassShineSweep/>
                        </Border>
                        <Border IsHitTestVisible="False"
                                ClipToBounds="True"
                                IsVisible="{DynamicResource LG.NoiseEnabled}"
                                CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}">
                            <Border.Background>
                                <ImageBrush Source="avares://ClassIsland.LiquidGlass/Assets/noise.png"
                                            TileMode="Tile"
                                            Stretch="None"
                                            Opacity="0.10"/>
                            </Border.Background>
                        </Border>
                        <Border ClipToBounds="True"
                                MinWidth="40"
                                CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}">
                            <ContentPresenter Content="{Binding}"
                                              Margin="16 0" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>

        <Style Selector="^ /template/ Grid#GridContentRoot TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LG.TextBrush}"/>
        </Style>

        <Setter Property="Template" Value="{StaticResource MainWindowLineFullControlTemplate}"/>

        <Style Selector="^[(ci|ComponentPresenter.IsMainWindowLoaded)=True]">
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.150"/>
                        <DoubleTransition Property="BackgroundWidth" Duration="0:0:0.350" Easing="0.22, 1, 0.36, 1"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="^[IsNotificationEnabled=False]">
            <Setter Property="Template" Value="{StaticResource MainWindowLineMinControlTemplate}"/>
            <Setter Property="IsVisible" Value="{Binding IsAllComponentsHid, RelativeSource={RelativeSource Self}, Converter={StaticResource InvertBooleanConverter}}"/>
        </Style>

        <Style Selector="^[IsNotificationEnabled=True]">
            <Style Selector="^ /template/ ContentPresenter#OverlayMaskContent">
            </Style>
            <Style Selector="^ /template/ Grid#GridContentRoot">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity"
                                          Duration="0:0:0.25">
                            <DoubleTransition.Easing>
                                <SineEaseIn/>
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </Setter>
                <Setter Property="Opacity" Value="1"/>
            </Style>

            <Style Selector="^:mask-anim">
                <Style Selector="^ /template/ Border#OverlayMask">
                </Style>

                <Style Selector="^:mask-in">
                    <Style Selector="^ /template/ controls|SlantedMaskControl.mask-bg">
                        <Setter Property="IsOpened" Value="True"/>
                    </Style>

                    <Style Selector="^[(ci|MainWindowStylesAssist.IsIslandSeperated)=False] /template/ Border#BackgroundBorderOverlayMask">
                        <Setter Property="BoxShadow" Value="0 8 40 0 #40000000, 0 0 1 0 #10FFFFFF inset"/>
                    </Style>
                    <Style Selector="^[(ci|MainWindowStylesAssist.IsIslandSeperated)=True] /template/ Border#OverlayMaskShadowRoot">
                        <Setter Property="BoxShadow" Value="0 8 40 0 #40000000, 0 0 1 0 #10FFFFFF inset"/>
                    </Style>
                    <Style Selector="^ /template/ ContentPresenter#OverlayMaskContent">
                        <Style.Animations>
                            <Animation Delay="0:0:0.28" Duration="0:0:0.3" IterationCount="1"
                                       FillMode="Both"
                                       Easing="0.22, 1, 0.36, 1">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                            <Animation Delay="0:0:0.28" Duration="0:0:0.8" IterationCount="1"
                                       FillMode="Both"
                                       Easing="0.22, 1, 0.36, 1">
                                <KeyFrame Cue="0%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.08"/>
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.08"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^ /template/ Border#BackgroundBorderOverlayMask">
                        <Style.Animations>
                            <Animation Delay="0:0:0.60" Duration="0:0:0.15" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^ /template/ Grid#GridContentRoot">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="^ /template/ Border#GlassHighlightOverlay">
                        <Style.Animations>
                            <Animation Duration="0:0:0.3" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Style>
                <Style Selector="^:mask-out">
                    <Style Selector="^ /template/ controls|SlantedMaskControl.mask-bg">
                        <Setter Property="IsOpened" Value="False"/>
                    </Style>
                    <Style Selector="^ /template/ ContentPresenter#OverlayMaskContent">
                        <Style.Animations>
                            <Animation Duration="0:0:0.22" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                            </Animation>
                            <Animation Duration="0:0:0.22" IterationCount="1"
                                       FillMode="Both"
                                       Easing="0.55, 0, 1, 0.45">
                                <KeyFrame Cue="0%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.06"/>
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.06"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^ /template/ Border#BackgroundBorderOverlayMask">
                        <Style.Animations>
                            <Animation Duration="0:0:0.12" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^ /template/ Grid#GridContentRoot">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="^ /template/ Border#BackgroundBorderOverlayMask">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="^ /template/ Border#GlassHighlightOverlay">
                        <Style.Animations>
                            <Animation Delay="0:0:0.1" Duration="0:0:0.25" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Style>
            </Style>
            <Style Selector="^:overlay-anim">
                <Style Selector="^ /template/ Grid#GridOverlay">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity"
                                              Duration="0:0:0.25">
                                <DoubleTransition.Easing>
                                    <SineEaseIn/>
                                </DoubleTransition.Easing>
                            </DoubleTransition>
                        </Transitions>
                    </Setter>
                    <Setter Property="Opacity" Value="0"/>
                </Style>

                <Style Selector="^:overlay-out">
                    <Style Selector="^ /template/ Grid#GridOverlay">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="^ /template/ Grid#GridContentRoot">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                </Style>
            </Style>

            <Style Selector="^:overlay-in">
                <Style Selector="^ /template/ Grid#GridOverlay">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <Style Selector="^ /template/ Grid#GridContentRoot">
                    <Setter Property="Opacity" Value="0"/>
                </Style>
            </Style>
            <Style Selector="^ /template/ ProgressBar#OverlayTimeProgressBar">
                <Setter Property="MinWidth" Value="0"/>
            </Style>
        </Style>
    </Style>
</Styles>